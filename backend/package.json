{
  "name": "bubble-catcher-backend",
  "version": "2.0.0",
  "description": "Bubble Catcher API — Elysia + Bun backend for SQL analysis and sandboxed execution. Self-hosted",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:triggers": "bun run src/db/apply-triggers.ts",
    "db:setup": "bun run db:migrate && bun run db:triggers"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.0",
    "@elysiajs/jwt": "^1.1.0",
    "@elysiajs/swagger": "^1.3.1",
    "@faker-js/faker": "^10.6.0",
    "dockerode": "^4.0.2",
    "drizzle-orm": "^0.36.0",
    "elysia": "^1.1.0",
    "node-sql-parser": "^5.3.0",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "^1.4.2",
    "@types/dockerode": "^3.3.31",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.5.0"
  }
}
