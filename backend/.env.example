# Database (self-hosted Postgres — no Supabase)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bubble_catcher

# Auth — generate a random 32+ char secret, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Short-lived access token (verified on every request, stateless)
ACCESS_TOKEN_EXPIRES_IN=15m
# Long-lived, revocable, rotated on every use (see /auth/refresh)
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN_HOURS=24

# Server
PORT=3001
# Frontend origin for CORS (no trailing slash, no wildcard). REQUIRED (no
# localhost fallback) when NODE_ENV=production.
CORS_ORIGIN=http://localhost:5173
# Base URL of the frontend — used to build links inside emails (reset/verify)
FRONTEND_URL=http://localhost:5173

# Email (SMTP) — works with any provider: Postfix, Mailgun, SES, a Gmail app
# password, etc. If SMTP_HOST is left unset, password-reset and
# email-verification links are only written to the server logs instead of
# emailed — fine for local dev or a private single-user instance, NOT fine
# for an instance with real end users (the backend warns loudly at boot).
# SMTP_HOST=smtp.mailprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=Bubble Catcher <no-reply@yourdomain.com>

# Docker Sandbox
SANDBOX_TIMEOUT_MS=10000
SANDBOX_MEMORY_LIMIT=128m
SANDBOX_CPU_LIMIT=0.5
# Comma-separated list of dialects this instance runs. MSSQL needs ~2GB RAM
# to start reliably — leave it out on small VPS instances.
SANDBOX_ENABLED_DIALECTS=sqlite,postgresql
# Sandbox image tag to run. Defaults to the last version tag produced by
# `docker/build-images.sh` (which tags both `:latest` and `:1.0.0`) —
# intentionally NOT `:latest`, so a sandbox image rebuild never silently
# changes what a running instance executes until you bump this explicitly.
SANDBOX_IMAGE_TAG=1.0.0

# Instance-wide limits (no plan tiers — single self-hosted instance)
MAX_PROJECTS_PER_USER=20
MAX_QUERY_LENGTH=20000
MAX_EXECUTIONS_PER_MINUTE=30
MAX_ANALYSIS_PER_MINUTE=60
IP_RATE_LIMIT_PER_MINUTE=60

# Optional — enables a Redis-backed rate limiter for multi-replica deployments.
# Leave unset for the default single-process in-memory limiter (fine for most self-hosts).
# NOT YET IMPLEMENTED as of this version — reserved for a follow-up; setting it currently has no effect.
# REDIS_URL=redis://localhost:6379

# Environment
NODE_ENV=development
