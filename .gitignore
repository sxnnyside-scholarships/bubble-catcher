# ============================================================
# Bubble Catcher - Monorepo .gitignore
# ============================================================

# Dependencies (monorepo-aware)
node_modules/
backend/node_modules/
frontend/node_modules/
shared/node_modules/

# Lockfiles (Bun)
bun.lockb

# Build output
dist/
build/
.svelte-kit/
backend/dist/
frontend/build/
frontend/.svelte-kit/

# Environment files
.env
.env.local
.env.*.local
.env.production
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local

# Test coverage
coverage/
.nyc_output/
backend/coverage/
frontend/coverage/

# Docker artifacts
.dockerignore
docker/**/*.log
docker/**/*.tmp

# Sandbox temporary files
backend/sandbox-temp/
/tmp/bubble-catcher-*

# Generated types
*.generated.ts
*.generated.d.ts

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.fleet/
.nova/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Vite temporary files
vite.config.ts.timestamp-*
vite.config.js.timestamp-*

# TypeScript cache
*.tsbuildinfo

# Misc
*.tgz
*.zip
.cache/
